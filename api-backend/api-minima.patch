+
+@pytest.mark.parametrize(
+    ("metodo", "caminho"),
+    [
+        ("post", "/tanques"),
+        ("patch", "/tanques/1"),
+        ("post", "/dispositivos"),
+        ("patch", "/dispositivos/1"),
+        ("patch", "/sensores/1"),
